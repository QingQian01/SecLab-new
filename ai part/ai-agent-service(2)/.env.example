# ── Dify Agent 配置 ──────────────────────────────────────────
DIFY_API_URL=https://api.dify.ai/v1
DIFY_API_KEY=app-dOnVHdf7HKM5BuLy4942IKVd

# ── 本服务监听配置 ─────────────────────────────────────────
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8010

# ── 前端跨域白名单（逗号分隔）───────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost,http://192.168.1.106:5173,http://192.168.1.106

# ── Docker 工具安全白名单（容器名前缀，逗号分隔）─────────────
ALLOWED_CONTAINER_PREFIXES=sqli,xss,csrf,upload,dir,cmd,sec-code

# ── 日志最大行数 ───────────────────────────────────────────
MAX_LOG_LINES=200

# ── Docker 工具 API Key（Dify 调用工具时携带，留空=不校验）──
# 本地/内网部署推荐留空；需要鉴权时填写，并在 Dify 工具的
# Authentication 中设置 Bearer Token 或 X-SecLab-Token 头为相同值
TOOL_API_KEY=

