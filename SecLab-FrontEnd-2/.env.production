# ════════════════════════════════════════════════════════════════
# SecLab 前端生产环境变量
# 仅在 `npm run build` 时由 Vite 自动加载。
# 所有 API 地址使用相对路径，由 nginx 反向代理转发到对应后端服务，
# 这样校园网其他终端访问 http://<服务器IP>:8088/ 时不会把请求打到自己电脑的 localhost。
# ════════════════════════════════════════════════════════════════

# 用户服务（user-service 8083）：/stu/* /admin/* 由 nginx 转发
VITE_API_BASE_URL=

# 实验模块服务（experiment-module-service 8084）：/course/* /stu/module/* 由 nginx 转发
VITE_EXPERIMENT_MODULE_BASE_URL=

# 图片服务（image-service 8086）：/api/images/* 由 nginx 转发
VITE_IMAGE_SERVICE_BASE_URL=/api/images

# Docker API（ai-agent-service 8010）：/api/docker/* 由 nginx 转发
VITE_DOCKER_API_URL=

# AI Agent / learning-event API（ai-agent-service 8010）：/api/* 由 nginx 转发
VITE_AGENT_BASE_URL=

# noVNC 操作环境桌面地址（由 ai-agent-service 动态返回 ws_path，前端用 window.location.host 拼接）
VITE_NOVNC_URL=

# 阿里云 OSS 教学视频地址（公共读 bucket，前端直接拼接 URL 播放）
VITE_OSS_BASE_URL=https://seclab2026.oss-cn-hangzhou.aliyuncs.com
