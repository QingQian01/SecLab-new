[Unit]
Description=SecLab AI Agent Service
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=seclab
WorkingDirectory=/opt/seclab/SecLab/seclab-backend/ai-agent-service
Environment=PATH=/opt/seclab/SecLab/seclab-backend/ai-agent-service/venv/bin
Environment=MYSQL_HOST=127.0.0.1
Environment=MYSQL_PORT=3306
Environment=MYSQL_USER=seclab_app
Environment=MYSQL_PASSWORD=Seclab@123
Environment=MYSQL_DATABASE=seclab_profile
# DIFY_API_KEY / DIFY_API_URL / CORS 等由 ai-agent-service/.env 提供（load_dotenv 自动加载）
ExecStart=/opt/seclab/SecLab/seclab-backend/ai-agent-service/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8010 --workers 1
Restart=on-failure
RestartSec=5
MemoryMax=200M
StandardOutput=append:/opt/seclab/logs/ai-agent.log
StandardError=append:/opt/seclab/logs/ai-agent.err.log

[Install]
WantedBy=multi-user.target
